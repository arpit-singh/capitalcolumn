---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ArticleCardCompact from '../../components/ArticleCardCompact.astro';
import {
  getCategoryBySlug,
  getArticles,
} from '../../lib/data';

export const prerender = false;

const { slug } = Astro.params;
const category = await getCategoryBySlug(slug as string);

if (!category) {
  return Astro.redirect('/404');
}

const articles = await getArticles({ category: category.slug });
const featuredArticle = articles[0];
const gridArticles = articles.slice(1, 4);
const remainingArticles = articles.slice(4);
const articleCount = articles.length;
---

<BaseLayout
  title={category.name}
  description={category.description}
>
  <div class="container">
    <!-- Category Header -->
    <header class="category-header">
      <nav class="category-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="category-breadcrumb-sep" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </span>
        <span aria-current="page">{category.name}</span>
      </nav>
      <div class="category-header-content">
        <div class="category-header-text">
          <h1 class="category-title">{category.name}</h1>
          <p class="category-description">{category.description}</p>
        </div>
        <div class="category-header-meta">
          <span class="category-count">{articleCount} article{articleCount !== 1 ? 's' : ''}</span>
        </div>
      </div>
    </header>

    {articles.length === 0 && (
      <div class="category-empty">
        <div class="category-empty-icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
        <p class="category-empty-text">No articles in this category yet.</p>
        <p class="category-empty-subtext">Check back soon for new coverage.</p>
      </div>
    )}

    {/* Featured Article — horizontal card with image */}
    {featuredArticle && (
      <section class="category-featured" aria-label="Featured article">
        <ArticleCard article={featuredArticle} showImage={true} variant="horizontal" />
      </section>
    )}

    {/* Article Grid — cards with images */}
    {gridArticles.length > 0 && (
      <section class="category-grid" aria-label="More articles">
        {gridArticles.map((article) => (
          <ArticleCard article={article} showImage={true} />
        ))}
      </section>
    )}

    {/* Remaining Articles — compact list */}
    {remainingArticles.length > 0 && (
      <section class="category-list" aria-label="All articles">
        <h2 class="category-list-heading">More in {category.name}</h2>
        <div class="category-list-inner">
          {remainingArticles.map((article, i) => (
            <ArticleCardCompact article={article} index={gridArticles.length + 1 + i} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  /* ---- Category Header ---- */
  .category-header {
    padding: var(--space-8) 0 var(--space-6);
    margin-bottom: var(--space-8);
  }

  .category-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }
  .category-breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .category-breadcrumb a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .category-breadcrumb-sep {
    display: flex;
    align-items: center;
    color: var(--color-border-strong);
  }
  .category-breadcrumb [aria-current="page"] {
    color: var(--color-text-secondary);
    font-weight: var(--weight-medium);
  }

  .category-header-content {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 2px solid var(--color-border-strong);
  }

  .category-title {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-bottom: var(--space-2);
    letter-spacing: -0.02em;
  }

  .category-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 640px;
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .category-count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    background-color: var(--color-bg-alt);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
  }

  /* ---- Featured Section ---- */
  .category-featured {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  /* ---- Grid Section ---- */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  /* ---- Compact List Section ---- */
  .category-list {
    padding-bottom: var(--space-12);
  }

  .category-list-heading {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  /* ---- Empty State ---- */
  .category-empty {
    text-align: center;
    padding: var(--space-16) 0;
  }
  .category-empty-icon {
    color: var(--color-border-strong);
    margin-bottom: var(--space-4);
  }
  .category-empty-text {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }
  .category-empty-subtext {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
    .category-header-content {
      flex-direction: column;
      align-items: flex-start;
    }
    .category-title {
      font-size: var(--text-3xl);
    }
  }
</style>
