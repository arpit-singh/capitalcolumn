---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles, getCategories } from '../lib/data';

const allArticles = getArticles();
const categories = getCategories();
---

<BaseLayout
  title="Search"
  description="Search CapitalColumn for financial news, market analysis, earnings coverage, and company updates."
>
  <div class="container">
    <header class="search-header">
      <h1>Search</h1>
    </header>

    <div class="search-controls">
      <div class="search-input-wrap">
        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="search-input"
          class="input search-field"
          placeholder="Search articles, companies, tickers..."
          aria-label="Search articles"
        />
      </div>
      <select id="category-filter" class="input search-select" aria-label="Filter by category">
        <option value="">All Categories</option>
        {categories.map((cat) => (
          <option value={cat.slug}>{cat.name}</option>
        ))}
      </select>
    </div>

    <div id="search-results" class="search-results">
      <p class="search-prompt">Enter a search term to find articles.</p>
    </div>

    {/* Pre-render all articles as hidden data for client-side search */}
    <div id="articles-data" style="display:none;" data-articles={JSON.stringify(
      allArticles.map(a => ({
        slug: a.slug,
        title: a.title,
        dek: a.dek,
        summary: a.summary,
        category: a.category,
        tags: a.tags,
        tickers: a.tickers,
        published_at: a.published_at,
        reading_time_minutes: a.reading_time_minutes,
        article_type: a.article_type,
        is_ai_generated: a.is_ai_generated,
        is_editor_reviewed: a.is_editor_reviewed,
        fact_check_status: a.fact_check_status,
      }))
    )} />
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement;
  const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
  const resultsContainer = document.getElementById('search-results') as HTMLDivElement;
  const dataEl = document.getElementById('articles-data') as HTMLDivElement;

  const articles = JSON.parse(dataEl.dataset.articles || '[]');

  function search() {
    const query = input.value.toLowerCase().trim();
    const category = categoryFilter.value;

    if (!query && !category) {
      resultsContainer.innerHTML = '<p class="search-prompt">Enter a search term to find articles.</p>';
      return;
    }

    let results = articles;

    if (category) {
      results = results.filter((a: any) => a.category.slug === category);
    }

    if (query) {
      results = results.filter((a: any) =>
        a.title.toLowerCase().includes(query) ||
        a.dek.toLowerCase().includes(query) ||
        a.summary.toLowerCase().includes(query) ||
        a.tags.some((t: any) => t.name.toLowerCase().includes(query)) ||
        a.tickers.some((t: any) => t.ticker.toLowerCase().includes(query) || t.name.toLowerCase().includes(query))
      );
    }

    if (results.length === 0) {
      resultsContainer.innerHTML = '<p class="search-prompt">No articles found. Try a different search term.</p>';
      return;
    }

    const html = results.map((a: any) => `
      <a href="/news/${a.slug}" class="search-result-card">
        <span class="search-result-card__category">${a.category.name}</span>
        <h3 class="search-result-card__title">${a.title}</h3>
        <p class="search-result-card__dek">${a.dek}</p>
      </a>
    `).join('');

    resultsContainer.innerHTML = `<p class="search-count">${results.length} result${results.length !== 1 ? 's' : ''}</p>${html}`;
  }

  input.addEventListener('input', search);
  categoryFilter.addEventListener('change', search);
</script>

<style>
  .search-header {
    padding: var(--space-8) 0 var(--space-4);
  }
  .search-header h1 {
    font-size: var(--text-3xl);
  }
  .search-controls {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .search-input-wrap {
    position: relative;
    flex: 1;
  }
  .search-icon {
    position: absolute;
    left: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }
  .search-field {
    padding-left: var(--space-10);
    width: 100%;
  }
  .search-select {
    min-width: 200px;
  }
  .search-prompt {
    text-align: center;
    padding: var(--space-12) 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
  .search-count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }
  .search-results {
    padding-bottom: var(--space-12);
  }

  @media (max-width: 640px) {
    .search-controls {
      flex-direction: column;
    }
    .search-select {
      min-width: 100%;
    }
  }
</style>

<style is:global>
  .search-result-card {
    display: block;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-3);
    text-decoration: none;
    color: var(--color-text);
    transition: box-shadow var(--transition-base), border-color var(--transition-base);
  }
  .search-result-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent);
  }
  .search-result-card__category {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    font-weight: var(--weight-semibold);
  }
  .search-result-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin: var(--space-1) 0;
    line-height: var(--leading-snug);
  }
  .search-result-card__dek {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }
</style>
