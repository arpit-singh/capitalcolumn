---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import SourceCard from '../../components/SourceCard.astro';
import TickerChip from '../../components/TickerChip.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import NewsletterCTA from '../../components/NewsletterCTA.astro';
import { renderMarkdown } from '../../lib/markdown';
import { formatDate } from '../../lib/formatters';
import {
  getArticleBySlug,
  getRelatedArticles,
  getArticles,
} from '../../lib/data';

export async function getStaticPaths() {
  const articles = await getArticles({ limit: 100 }); // API max limit is 100
  return articles.map((article) => ({
    params: { slug: article.slug },
  }));
}

const { slug } = Astro.params;
const article = await getArticleBySlug(slug as string);

if (!article) {
  return Astro.redirect('/404');
}

const bodyHtml = renderMarkdown(article.body_markdown);
const relatedArticles = await getRelatedArticles(article, 3);
---

<ArticleLayout article={article}>
  {/* Key Takeaways */}
  {article.key_takeaways && article.key_takeaways.length > 0 && (
    <section class="article-section">
      <KeyTakeaways takeaways={article.key_takeaways} />
    </section>
  )}

  {/* Featured Image */}
  {article.featured_image && (
    <figure class="article-featured-image">
      <img
        src={article.featured_image.public_url}
        alt={article.featured_image.alt_text}
        width={article.featured_image.width}
        height={article.featured_image.height}
        loading="eager"
      />
      {(article.featured_image.caption || article.featured_image.credit) && (
        <figcaption>
          {article.featured_image.caption}
          {article.featured_image.credit && (
            <span class="image-credit"> — {article.featured_image.credit}</span>
          )}
        </figcaption>
      )}
    </figure>
  )}

  {/* Article Body */}
  <div class="article-body" set:html={bodyHtml} />

  {/* Ticker Chips */}
  {article.tickers.length > 0 && (
    <div class="article-tickers">
      <span class="article-tickers__label">Related tickers:</span>
      {article.tickers.map((t) => (
        <TickerChip ticker={t.ticker} exchange={t.exchange} />
      ))}
    </div>
  )}

  {/* Source Cards */}
  {article.sources.length > 0 && (
    <section class="source-cards-section">
      <h2 class="source-cards-section__title">Sources</h2>
      <p class="source-cards-section__note">
        This article references the following sources. Primary sources are marked with a badge.
      </p>
      <div class="source-cards-grid">
        {article.sources.map((source) => (
          <SourceCard source={source} />
        ))}
      </div>
    </section>
  )}

  {/* Correction Notice */}
  {article.correction_note && (
    <aside class="correction-notice" role="alert">
      <strong>Correction</strong>
      <span class="correction-notice__date">
        {article.last_corrected_at ? ` — ${formatDate(article.last_corrected_at)}` : ''}
      </span>
      <p>{article.correction_note}</p>
    </aside>
  )}

  {/* Disclaimer */}
  <aside class="article-disclaimer">
    <p>
      <strong>Disclaimer:</strong> This article is for informational purposes only and does not constitute
      financial advice. {article.is_ai_generated ? 'This content was generated with AI assistance and ' : ''}
      {article.is_editor_reviewed ? 'has been reviewed by our editorial team. ' : 'may not have been reviewed by a human editor. '}
      Always consult a qualified financial advisor before making investment decisions.
    </p>
  </aside>

  {/* Related Articles */}
  {relatedArticles.length > 0 && (
    <section class="article-section article-section--related">
      <RelatedArticles articles={relatedArticles} />
    </section>
  )}

  {/* Newsletter CTA */}
  <section class="article-section article-section--cta">
    <NewsletterCTA />
  </section>
</ArticleLayout>

<style>
  .article-section {
    margin: var(--space-8) 0;
  }
  .article-section--related {
    margin-top: var(--space-12);
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-border);
  }
  .article-section--cta {
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }
  .article-featured-image {
    margin: var(--space-6) 0 var(--space-8);
    max-width: 100%;
  }
  .article-featured-image img {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .article-featured-image figcaption {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
    line-height: var(--leading-normal);
    text-align: center;
    font-style: italic;
  }
  .image-credit {
    font-style: italic;
  }
  @media (max-width: 768px) {
    .article-featured-image img {
      max-height: 280px;
    }
  }
  .article-tickers {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin: var(--space-8) 0;
    padding: var(--space-4);
    background: var(--color-bg-alt);
    border-radius: var(--radius-md);
  }
  .article-tickers__label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: var(--weight-medium);
  }
  .source-cards-section {
    margin: var(--space-10) 0;
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  .source-cards-section__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }
  .source-cards-section__note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }
  .source-cards-grid {
    display: grid;
    gap: var(--space-3);
  }
  .correction-notice {
    margin: var(--space-8) 0;
    padding: var(--space-4) var(--space-5);
    background: #fef3c7;
    border-left: 4px solid var(--color-warning);
    border-radius: var(--radius-sm);
  }
  .correction-notice__date {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .correction-notice p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
  .article-disclaimer {
    margin: var(--space-8) 0;
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg-alt);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>
