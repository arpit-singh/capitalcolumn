---
import type { Article } from '../lib/types';
import ProvenanceBadge from './ProvenanceBadge.astro';
import TickerChip from './TickerChip.astro';

interface Props {
  article: Article;
  showImage?: boolean;
  variant?: 'default' | 'horizontal';
}

const { article, showImage = true, variant = 'default' } = Astro.props;

function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

function formatTimeAgo(dateStr: string): string {
  const now = new Date();
  const date = new Date(dateStr);
  const diff = now.getTime() - date.getTime();
  const hours = Math.floor(diff / (1000 * 60 * 60));
  const minutes = Math.floor(diff / (1000 * 60));

  if (minutes < 60) return `${minutes}m ago`;
  if (hours < 24) return `${hours}h ago`;
  if (hours < 48) return 'Yesterday';
  return formatDate(dateStr);
}

function truncateSummary(text: string, maxLen: number = 160): string {
  if (text.length <= maxLen) return text;
  return text.slice(0, maxLen).replace(/\s+\S*$/, '') + '…';
}

function getProvenanceType(article: Article): 'ai_assisted' | 'editor_reviewed' | 'source_verified' | 'updated' | 'corrected' {
  if (article.correction_note) return 'corrected';
  if (article.is_editor_reviewed) return 'editor_reviewed';
  if (article.fact_check_status === 'source_verified') return 'source_verified';
  if (article.is_ai_generated) return 'ai_assisted';
  return 'ai_assisted';
}

const articleUrl = `/news/${article.slug}`;
const hasImage = showImage && article.featured_image;
const provenanceType = getProvenanceType(article);
---

<article class:list={['article-card', `article-card--${variant}`, { 'article-card--has-image': hasImage }]}>
  {hasImage && (
    <a href={articleUrl} class="article-card-image-link" tabindex="-1" aria-hidden="true">
      <div class="article-card-image-wrap">
        <img
          src={article.featured_image!.public_url}
          alt={article.featured_image!.alt_text || article.title}
          class="article-card-image"
          loading="lazy"
          width={article.featured_image!.width}
          height={article.featured_image!.height}
        />
      </div>
    </a>
  )}

  <div class="article-card-body">
    <div class="article-card-meta-top">
      <a href={`/category/${article.category.slug}`} class="article-card-category">
        {article.category.name}
      </a>
    </div>

    <h3 class="article-card-title">
      <a href={articleUrl} class="article-card-title-link">
        {article.title}
      </a>
    </h3>

    {variant === 'default' && article.summary && (
      <p class="article-card-summary">{truncateSummary(article.summary)}</p>
    )}

    <div class="article-card-meta-bottom">
      <time datetime={article.published_at} class="article-card-time">
        {formatTimeAgo(article.published_at)}
      </time>
      <span class="article-card-reading-time" aria-label={`${article.reading_time_minutes} minute read`}>
        {article.reading_time_minutes} min read
      </span>
      <ProvenanceBadge type={provenanceType} />
      {article.tickers?.length > 0 && (
        <div class="article-card-tickers">
          {article.tickers.slice(0, 3).map((t) => (
            <TickerChip ticker={t.ticker} exchange={t.exchange} />
          ))}
        </div>
      )}
    </div>
  </div>
</article>
