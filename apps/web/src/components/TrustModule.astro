---
const steps = [
  {
    icon: 'research',
    title: 'AI-Powered Research',
    description: 'Our AI agents scan hundreds of sources to identify market-moving stories and extract key data points with precision.',
  },
  {
    icon: 'source',
    title: 'Source-Linked Reporting',
    description: 'Every claim is traced back to primary sources — filings, press releases, exchange disclosures, and official data.',
  },
  {
    icon: 'review',
    title: 'Editorial Oversight',
    description: 'Published articles are reviewed for accuracy, context, and editorial standards before reaching you.',
  },
];
---

<section class="trust-module" aria-labelledby="trust-heading">
  <div class="trust-inner container">
    <div class="trust-header">
      <span class="trust-eyebrow">Our Process</span>
      <h2 id="trust-heading" class="trust-heading">How We Work</h2>
      <p class="trust-subheading">AI-assisted journalism with full transparency and editorial integrity.</p>
    </div>
    <div class="trust-grid">
      {steps.map((step, i) => (
        <div class="trust-card">
          <div class="trust-card-icon-wrap">
            {step.icon === 'research' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                <path d="M2 17l10 5 10-5"/>
                <path d="M2 12l10 5 10-5"/>
              </svg>
            )}
            {step.icon === 'source' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
              </svg>
            )}
            {step.icon === 'review' && (
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 11l3 3L22 4"/>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
              </svg>
            )}
            <span class="trust-card-number">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="trust-card-title">{step.title}</h3>
          <p class="trust-card-description">{step.description}</p>
        </div>
      ))}
    </div>
    <div class="trust-cta">
      <a href="/editorial-policy" class="trust-link">
        Read our editorial policy
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .trust-header {
    text-align: center;
    margin-bottom: var(--space-10);
  }
  .trust-eyebrow {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }
  .trust-subheading {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 500px;
    margin: 0 auto;
  }
  .trust-card-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin: 0 auto var(--space-5);
    background-color: var(--color-accent-light);
    border-radius: var(--radius-lg);
    color: var(--color-accent);
    position: relative;
  }
  .trust-card-number {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-accent);
    color: #FFFFFF;
    font-size: 0.625rem;
    font-weight: var(--weight-bold);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
  }
</style>
